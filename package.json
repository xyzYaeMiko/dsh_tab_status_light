{
  "name": "dsh-tab-status-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Web plugin: recolors the browser-tab DSH whale by session state — running, waiting for your answer, output finished — painting concurrent states as left-to-right color bands.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "favicon",
    "browser-tab",
    "session-status"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyzYaeMiko/dsh-tab-status-light.git"
  },
  "homepage": "https://github.com/xyzYaeMiko/dsh-tab-status-light#readme",
  "bugs": {
    "url": "https://github.com/xyzYaeMiko/dsh-tab-status-light/issues"
  }
}
